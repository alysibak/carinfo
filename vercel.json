{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=server && npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "routes": [
    { "src": "/api(?:/(.*))?", "dest": "/api/index" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "server/data/**",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}
