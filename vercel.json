{
  "version": 2,
  "installCommand": "npm install",
  "buildCommand": "npm run build --workspace=server && npm run build --workspace=client",
  "outputDirectory": "client/dist",
  "routes": [
    { "src": "/api/(.*)", "dest": "/api/$1" },
    { "handle": "filesystem" },
    { "src": "/(.*)", "dest": "/index.html" }
  ],
  "functions": {
    "api/**/*.ts": {
      "includeFiles": "{server/data/**,server/dist/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  }
}

