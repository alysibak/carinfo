{
  "version": 2,
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "client/dist",
  "rewrites": [
    {
      "source": "/api(/.*)?",
      "destination": "/api/index"
    },
    {
      "source": "/car/([^/]+)",
      "destination": "/api/index"
    },
    {
      "source": "/car/([^/]+)/",
      "destination": "/api/index"
    },
    {
      "source": "/models/([^/]+)/([^/]+)",
      "destination": "/api/index"
    },
    {
      "source": "/models/([^/]+)/([^/]+)/",
      "destination": "/api/index"
    },
    {
      "source": "/models/([^/]+)/([^/]+)/(\\d{4})",
      "destination": "/api/index"
    },
    {
      "source": "/models/([^/]+)/([^/]+)/(\\d{4})/",
      "destination": "/api/index"
    },
    {
      "source": "/compare",
      "destination": "/api/index"
    },
    {
      "source": "/compare/",
      "destination": "/api/index"
    },
    {
      "source": "/((?!assets/)(?!.*\\.[a-zA-Z0-9]{2,5}$).*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/index.ts": {
      "includeFiles": "{server/data/cars-ready.json,server/data/recalls-canada.json,server/data/complaints.json,server/data/investigations.json,server/data/nhtsa-ratings.json,client/dist/index.html}",
      "excludeFiles": "{data/**,server/data/cars.json,server/data/raw/**}",
      "maxDuration": 60,
      "memory": 1024
    }
  },
  "crons": [
    {
      "path": "/api/cron/recall-alerts",
      "schedule": "0 14 * * *"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(sitemap.xml|sitemaps/.*|robots.txt)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, s-maxage=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), geolocation=(), microphone=(), interest-cohort=()"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'none'; frame-src 'none'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob: https://upload.wikimedia.org https://*.wikimedia.org; font-src 'self' data:; connect-src 'self' https://upload.wikimedia.org https://*.wikimedia.org blob:; worker-src 'self' blob:; media-src 'self' blob:; upgrade-insecure-requests"
        }
      ]
    }
  ]
}
