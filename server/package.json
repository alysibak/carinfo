{
  "name": "carinfo-server",
  "version": "1.0.0",
  "description": "Backend API for car comparison website",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "build-verified-db": "tsx scripts/build-verified-database.ts",
    "build-verified-db:fast": "tsx scripts/build-verified-database.ts --skip-nhtsa",
    "build-enrichment": "tsx scripts/build-content-enrichment.ts",
    "build-runtime-db": "tsx scripts/build-runtime-database.ts",
    "build-nhtsa-backfill": "tsx scripts/build-nhtsa-backfill.ts --",
    "build-horsepower": "tsx scripts/build-horsepower-enrichment.ts",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.scripts.json",
    "validate:data": "tsx scripts/validate-data.ts",
    "build-sitemap": "tsx scripts/build-sitemap.ts"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.0",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.22.3",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "pg": "^8.22.0",
    "stripe": "^22.4.0"
  },
  "devDependencies": {
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "@types/pg": "^8.20.3",
    "csv-parse": "^7.0.2",
    "exceljs": "^4.4.0",
    "tsx": "^4.7.0",
    "typescript": "5.9.3"
  }
}
