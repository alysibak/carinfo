{
  "name": "carinfo",
  "version": "1.0.0",
  "description": "Comprehensive car comparison website",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "client",
    "server"
  ],
  "scripts": {
    "dev": "concurrently \"npm run dev:server\" \"npm run dev:client\"",
    "dev:client": "npm run dev --workspace=client",
    "dev:server": "npm run dev --workspace=server",
    "build": "npm run build --workspace=server && npm run build-runtime-db --workspace=server && npm run build --workspace=client",
    "build:client": "npm run build --workspace=client",
    "build:server": "npm run build --workspace=server",
    "build:runtime-db": "npm run build-runtime-db --workspace=server",
    "start": "npm run start --workspace=server",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "npm run typecheck --workspace=server && npm run typecheck --workspace=client",
    "verify": "npm run lint && npm run typecheck && npm test",
    "validate:data": "npm run validate:data --workspace=server"
  },
  "keywords": [
    "cars",
    "comparison",
    "automotive"
  ],
  "author": "",
  "license": "ISC",
  "devDependencies": {
    "@playwright/test": "^1.57.0",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "4.1.9",
    "concurrently": "^8.2.2",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^9.1.2",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.15.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0",
    "typescript-eslint": "^8.70.0",
    "vitest": "^4.1.9"
  },
  "overrides": {
    "shell-quote": "^1.10.0",
    "brace-expansion": "^2.1.7",
    "browserslist": "^4.29.0",
    "lodash": "^4.18.1",
    "minimatch": "^9.0.9",
    "picomatch": "^4.0.7",
    "rollup": "^4.63.4",
    "undici": "^7.29.1",
    "postcss-selector-parser": "^6.1.4",
    "baseline-browser-mapping": "^2.11.25",
    "nanoid": "^6.0.1"
  }
}
