# Copy this whole file to `.env` at the repo root; both the server and the
# Vite client read it from there.

# ─── Site ─────────────────────────────────────────────────────────────────────
# Public origin, used for canonical URLs, Open Graph URLs, sitemap.xml and
# robots.txt (all must be absolute). Falls back to APP_ORIGIN, then to Vercel's
# production domain. Without any, pages omit absolute URLs and no sitemap is
# written — never a localhost one.
# SITE_URL=https://carinfo.example

# Public site origin for Stripe Checkout success/cancel + portal return URLs.
# Also the CORS allowlist entry. Required in production.
APP_ORIGIN=http://localhost:3000
# Extra origins allowed to call the API from a browser (comma-separated).
# ADDITIONAL_ORIGINS=https://staging.carinfo.example

# ─── Accounts (Clerk) — https://dashboard.clerk.com ──────────────────────────
CLERK_SECRET_KEY=
VITE_CLERK_PUBLISHABLE_KEY=

# ─── Postgres (Neon, Supabase, etc.) ─────────────────────────────────────────
DATABASE_URL=
# TLS mode:
#   false   no TLS (local Postgres)
#   verify  TLS with certificate verification — recommended; add
#           DATABASE_CA_CERT (PEM) if your provider uses a private CA
#   unset   TLS without verification (legacy default; logs a warning in production)
# DATABASE_SSL=verify
# DATABASE_CA_CERT=
# Connections per serverless instance. Keep small, or point DATABASE_URL at a pooler.
# DATABASE_POOL_MAX=5
# DATABASE_CONNECT_TIMEOUT_MS=5000

# ─── Billing (Stripe) — https://dashboard.stripe.com ─────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ID for CarInfo Pro
STRIPE_PRICE_ID=

# ─── Operations ──────────────────────────────────────────────────────────────
# Requests slower than this are logged (ms).
# SLOW_REQUEST_MS=1000
# Turn off rate limiting (tests, load testing). Never in production.
# DISABLE_RATE_LIMIT=false

# ─── Tests ───────────────────────────────────────────────────────────────────
# Enables the real-Postgres suites (user store, Stripe webhook, account API).
# They skip when unset. Each test file uses its own throwaway schema.
# TEST_DATABASE_URL=postgresql://postgres@localhost:5432/carinfo_test

# ─── Client ──────────────────────────────────────────────────────────────────
# VITE_API_BASE_URL=/api
# Client request timeout (ms).
# VITE_API_TIMEOUT_MS=60000
