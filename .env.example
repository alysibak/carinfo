# Server (Express / Vercel serverless)
# Clerk — https://dashboard.clerk.com
CLERK_SECRET_KEY=

# Postgres (Neon, Supabase, etc.)
DATABASE_URL=
# Set to false for local Postgres without SSL
# DATABASE_SSL=false

# Stripe — https://dashboard.stripe.com
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# Recurring price ID for CarInfo Pro
STRIPE_PRICE_ID=

# Public site origin for Checkout success/cancel + portal return URLs
APP_ORIGIN=http://localhost:3000

# Client (Vite) — prefix with VITE_
# Copy this whole file to `.env` at the repo root; both the server and
# the Vite client read it from there.
VITE_CLERK_PUBLISHABLE_KEY=
# VITE_API_BASE_URL=/api
